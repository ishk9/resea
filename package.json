{
  "name": "treechat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./extension.cjs",
  "engines": {
    "vscode": "^1.90.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "treechat.open",
        "title": "TreeChat: Open"
      },
      {
        "command": "treechat.connect",
        "title": "TreeChat: Connect agents"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "treechat",
        "label": "TreeChat"
      }
    ]
  },
  "bin": {
    "treechat": "server/index.js"
  },
  "scripts": {
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node server/context.test.js"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@xyflow/react": "^12.11.2",
    "better-sqlite3": "^11.8.1",
    "express": "^4.21.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.4",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  }
}
